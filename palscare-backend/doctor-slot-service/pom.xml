<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- ======================================================================= -->
    <!-- PalsCare - Doctor Slot Service POM Configuration                        -->
    <!-- Purpose: Microservice managing physical clinics (chambers) and booking  -->
    <!-- schedule time slots backed by MongoDB NoSQL database.                   -->
    <!-- ======================================================================= -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Step 1: Parent module inheritance -->
    <parent>
        <groupId>com.palscare</groupId>
        <artifactId>palscare-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>doctor-slot-service</artifactId>
    <name>doctor-slot-service</name>
    <description>Doctor Chamber and Slot management microservice backed by MongoDB</description>

    <dependencies>
        <!-- Step 2: Spring Web Starter for REST API endpoints -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Step 3: Spring Data MongoDB - NoSQL document store replacing SQL/JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!-- Step 4: Spring Security for endpoint security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Step 5: Bean validation for request DTO constraints -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Step 6: Eureka discovery client for microservice discovery -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- Step 7: Lombok for boilerplate generation -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Step 8: Spring Boot testing suite -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Step 9: Spring Boot Maven packaging plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Step 10: Compiler plugin for Java 17 compatibility -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
