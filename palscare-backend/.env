# ==============================================================================
# PalsCare Microservices - Local Testing Environment Configuration (.env)
# ==============================================================================
# Step 1: MongoDB Atlas Cloud Connection URI
# NOTE: The '<' and '>' are placeholder brackets from MongoDB Atlas.
# If your password is 'arjtp98', use: arjtp98:arjtp98@... (without angle brackets).
# ==============================================================================

# Primary MongoDB connection string for all microservices
SPRING_DATA_MONGODB_URI=mongodb+srv://arjtp98:arjtp98@cluster-1.wtetsir.mongodb.net/palscare?retryWrites=true&w=majority&appName=cluster-1

# Service-specific MongoDB connection strings (if you want isolated databases per service)
USER_SERVICE_MONGODB_URI=mongodb+srv://arjtp98:arjtp98@cluster-1.wtetsir.mongodb.net/palscare_user?retryWrites=true&w=majority&appName=cluster-1
DOCTOR_SLOT_SERVICE_MONGODB_URI=mongodb+srv://arjtp98:arjtp98@cluster-1.wtetsir.mongodb.net/palscare_doctor_slot?retryWrites=true&w=majority&appName=cluster-1
BOOKING_SERVICE_MONGODB_URI=mongodb+srv://arjtp98:arjtp98@cluster-1.wtetsir.mongodb.net/palscare_booking?retryWrites=true&w=majority&appName=cluster-1

# Step 2: Service discovery & gateway ports
PORT_API_GATEWAY=8088
PORT_USER_SERVICE=8075
PORT_DOCTOR_SLOT_SERVICE=8055
PORT_BOOKING_SERVICE=8099
PORT_EUREKA_SERVER=8761

EUREKA_SERVER_URL=http://localhost:8761/eureka/
USER_SERVICE_URL=http://localhost:8075
DOCTOR_SLOT_SERVICE_URL=http://localhost:8055
BOOKING_SERVICE_URL=http://localhost:8099
